{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/guard-tool-use.mjs\"",
            "statusMessage": "Checking protected files and commands"
          }
        ]
      }
    ]
  }
}
